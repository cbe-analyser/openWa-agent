{
  "name": "openwa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable AI agent for WhatsApp customer support, automated troubleshooting, knowledge-grounded responses, and human handoff. Bring your own AI provider.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:prod": "node dist/worker.cjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:reencrypt": "tsx scripts/reencrypt-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "mammoth": "1.13.0",
    "next": "15.5.28",
    "openai": "7.39.0",
    "papaparse": "5.7.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "unpdf": "1.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.0"
  }
}
