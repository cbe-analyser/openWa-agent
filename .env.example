# ---------------------------------------------------------------------------
# OpenWa Agent configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public base URL of the dashboard/API (used for CSRF origin checks, webhook URLs and links).
APP_URL=http://localhost:3000
# Display name of the product (configurable; must not imply affiliation with WhatsApp or Meta).
APP_NAME="OpenWa Agent"

# single   = one business per installation (sign-up closes after the first organization)
# multi    = hosted multi-tenant service (users may create additional organizations)
# sandbox  = developer sandbox (simulator + mock AI are enabled and seeded)
DEPLOYMENT_MODE=single
# Allow new organizations to self-register in multi mode.
ALLOW_SIGNUP=false

# PostgreSQL 14+ with the pgvector extension.
DATABASE_URL=postgresql://openwa:change-me@localhost:5432/openwa

# 32-byte key, base64 encoded. Encrypts stored provider keys, WhatsApp tokens and webhook secrets.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Optional: the previous key during a rotation (decrypt-only). See docs/operations.md.
ENCRYPTION_KEY_PREVIOUS=

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# Emergency stop: when "true", no AI-generated message is sent by any organization.
# Can also be toggled at runtime by an instance administrator in Security settings.
AI_KILL_SWITCH=false

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Worker tuning
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=750

# Maximum upload size for knowledge documents, in megabytes.
MAX_UPLOAD_MB=10

# Allow URL imports / HTTP tools to reach private network addresses (keep false in production).
ALLOW_PRIVATE_NETWORK_FETCH=false

# Optional: demo data for evaluation (`npm run db:seed`, or `node dist/seed.cjs` in Docker).
# Creates a demo organization with the simulator and mock AI. A random password is printed if empty.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# AI provider credentials are NOT configured here. Add them in the dashboard
# (Agent settings → AI providers); they are stored encrypted with ENCRYPTION_KEY.

# ---- Docker Compose only -------------------------------------------------------------------
# Password for the bundled PostgreSQL container (required by docker-compose.yml).
POSTGRES_PASSWORD=
# Host port for the app, and the public domain used by the optional Caddy HTTPS proxy.
APP_PORT=3000
DOMAIN=support.example.com
